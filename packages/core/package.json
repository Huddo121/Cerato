{
  "name": "cerato",
  "version": "0.0.5",
  "description": "End-to-end typesafe API definitions for TypeScript",
  "keywords": [],
  "license": "MIT",
  "author": "Michael Hudson <huddo121@gmail.com>",
  "homepage": "https://github.com/Huddo121/Cerato",
  "bugs": {
    "url": "https://github.com/Huddo121/Cerato/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huddo121/Cerato.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.mts",
        "default": "./dist/internal.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "25.0.9",
    "tsdown": "0.20.0-beta.3",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "zod": "4.3.5"
  }
}
